generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IndexJobStatus {
  indexing
  indexed
  error
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MessageStatus {
  PENDING
  COMPLETED
  ERROR
}

model User {
  id            String         @id @db.Uuid
  email         String         @unique
  name          String
  imageUrl      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  indexJobs     IndexJob[]
  conversations Conversation[]
}

model Conversation {
  id            String    @id @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String    @default("New Conversation")
  model         String
  systemPrompt  String?
  isPinned      Boolean   @default(false)
  isArchived    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime  @default(now())
  messages      Message[]

  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([userId, isPinned, lastMessageAt(sort: Desc)])
}

model Message {
  id              String        @id @db.Uuid
  conversationId  String        @db.Uuid
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            MessageRole
  status          MessageStatus
  content         String        @db.Text
  parts           Json?
  metadata        Json?
  parentMessageId String?       @db.Uuid
  parentMessage   Message?      @relation("ParentMessage", fields: [parentMessageId], references: [id], onDelete: Cascade)
  children        Message[]     @relation("ParentMessage")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([conversationId, createdAt(sort: Desc)])
}

model IndexJob {
  id           String         @id @db.Uuid
  userId       String         @db.Uuid
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       IndexJobStatus @default(indexing)
  type         String
  label        String
  filename     String?
  mimeType     String?
  storedPath   String?
  url          String?
  kind         String?
  chunkCount   Int?
  errorMessage String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
}

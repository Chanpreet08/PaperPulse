# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paperpulse

# Embeddings (OpenAI-compatible; OpenRouter works via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chat models (GOOGLE | OPENAI)
MODEL_PROVIDER=GOOGLE
DEFAULT_MODEL=gemini-3.5-flash
GEMINI_API_KEY=

# Vector store
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=paper-pulse

# Indexing
INDEX_FILES_DIR=./uploads
